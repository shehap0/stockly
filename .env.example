# Copy to .env and adjust. For local development:
#   npm run db:start   (starts the local Supabase stack)
#   then write the generated keys into .env, e.g.:
#     supabase status -o env   → use API_URL and ANON_KEY values
# NEVER put the service-role key in a VITE_ variable — it must never reach the
# browser. It lives only in Supabase Edge Function secrets (managed by CLI).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from `supabase status -o env`>
